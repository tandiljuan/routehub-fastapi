ENVIRONMENT=LCL
# Used by local scripts/clients that call RouteHub (Authorization: Bearer <key>).
ROUTEHUB_API_KEY=rh_live_replace_me
OPTIMIZER_HOST=http://localhost
OPTIMIZER_PORT=3005
OPTIMIZER_AUTH=example
# Optional: override config/engine_defaults.json
# ENGINE_DEFAULTS_PATH=/service/config/engine_defaults.json
# PLAN_ROUTING_JSON={"distance_haversine_limit":15}

# Smart Import proxy (default off — legacy upload unchanged)
SMART_IMPORT_ENABLED=false
SMART_IMPORT_URL=http://host.docker.internal:8100
SMART_IMPORT_TIMEOUT=120
